# ─── Database ───────────────────────────────────────────────────────
# PostgreSQL connection string (async driver: asyncpg)
DATABASE_URL=postgresql+asyncpg://apix:changeme@localhost:5432/apix

# ─── Proxy Pool ─────────────────────────────────────────────────────
# HTTP proxy endpoint for IP rotation during extraction
# Format: http://user:pass@proxy-provider.example.com:port
PROXY_POOL_URL=http://user:pass@proxy.example.com:8080

# ─── Vision-Language Model ──────────────────────────────────────────
# Used as fallback when CSS/XPath selectors stop matching
# Supports OpenAI-compatible endpoints (GPT-4V, Gemini, etc.)
VLM_API_KEY=your-vlm-api-key-here
VLM_API_URL=https://api.openai.com/v1/chat/completions
VLM_MODEL=gpt-4o

# ─── Application ────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# How many extraction jobs run concurrently
CONCURRENCY_LIMIT=5

# Max retries per extraction job before marking as failed
MAX_RETRIES=3

# Base delay (seconds) for exponential backoff between retries
BACKOFF_BASE_SECONDS=2.0

# Polite delay range (seconds) between requests to the same site
POLITE_DELAY_MIN=1.0
POLITE_DELAY_MAX=3.0

# ─── FastAPI ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
